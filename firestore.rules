rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net: deny all access by default
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null && request.auth.token.email_verified == true;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidUserProfile(data, userId) {
      return data.keys().hasAll(['uid', 'displayName', 'email', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['uid', 'displayName', 'email', 'createdAt', 'updatedAt'])
        && data.uid is string && data.uid == userId && isValidId(data.uid)
        && data.displayName is string && data.displayName.size() >= 1 && data.displayName.size() <= 120
        && data.email is string && data.email.size() >= 3 && data.email.size() <= 320
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidPreferences(data, userId) {
      return data.keys().hasAll([
          'ownerId', 'isDark', 'sendOnEnter', 'autoScroll', 'language',
          'density', 'fontScale', 'completionChime', 'spokenStatusUpdates', 'voiceAutoSubmit',
          'soundProfile', 'volume', 'betaTraces', 'betaSelectionBar',
          'betaVoiceWave', 'betaCommandSearch', 'localModelEnabled',
          'localModelReady', 'localBackend', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'ownerId', 'isDark', 'sendOnEnter', 'autoScroll', 'language',
          'density', 'fontScale', 'completionChime', 'spokenStatusUpdates', 'voiceAutoSubmit',
          'soundProfile', 'volume', 'betaTraces', 'betaSelectionBar',
          'betaVoiceWave', 'betaCommandSearch', 'localModelEnabled',
          'localModelReady', 'localBackend', 'updatedAt'
        ])
        && data.ownerId is string && data.ownerId == userId && isValidId(data.ownerId)
        && data.isDark is bool
        && data.sendOnEnter is bool
        && data.autoScroll is bool
        && data.language is string && data.language.size() >= 1 && data.language.size() <= 40
        && data.density is string && (data.density == 'comfortable' || data.density == 'compact')
        && data.fontScale is string && (data.fontScale == 'default' || data.fontScale == 'large')
        && data.completionChime is bool
        && data.spokenStatusUpdates is bool
        && data.voiceAutoSubmit is bool
        && data.soundProfile is string && (data.soundProfile == 'chime' || data.soundProfile == 'click' || data.soundProfile == 'muted')
        && data.volume is number && data.volume >= 0 && data.volume <= 100
        && data.betaTraces is bool
        && data.betaSelectionBar is bool
        && data.betaVoiceWave is bool
        && data.betaCommandSearch is bool
        && data.localModelEnabled is bool
        && data.localModelReady is bool
        && data.localBackend is string && (data.localBackend == 'webgpu' || data.localBackend == 'cpu')
        && data.updatedAt is timestamp;
    }

    function isValidThread(data, userId, threadId) {
      return data.keys().hasAll(['id', 'ownerId', 'title', 'updatedAtLabel', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'ownerId', 'title', 'updatedAtLabel', 'pinned', 'folderId', 'createdAt', 'updatedAt'])
        && data.id is string && data.id == threadId && isValidId(data.id)
        && data.ownerId is string && data.ownerId == userId && isValidId(data.ownerId)
        && data.title is string && data.title.size() >= 1 && data.title.size() <= 160
        && data.updatedAtLabel is string && data.updatedAtLabel.size() >= 1 && data.updatedAtLabel.size() <= 40
        && (!data.keys().hasAny(['pinned']) || data.pinned is bool)
        && (!data.keys().hasAny(['folderId']) || data.folderId == null || (data.folderId is string && isValidId(data.folderId)))
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidFolder(data, userId, folderId) {
      return data.keys().hasAll(['id', 'ownerId', 'name', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly(['id', 'ownerId', 'name', 'createdAt', 'updatedAt'])
        && data.id is string && data.id == folderId && isValidId(data.id)
        && data.ownerId is string && data.ownerId == userId && isValidId(data.ownerId)
        && data.name is string && data.name.size() >= 1 && data.name.size() <= 80
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidMessage(data, userId, threadId, messageId) {
      return data.keys().hasAll(['id', 'ownerId', 'threadId', 'orderIndex', 'role', 'content', 'timestamp', 'createdAt', 'updatedAt'])
        && data.keys().hasOnly([
          'id', 'ownerId', 'threadId', 'orderIndex', 'role', 'content',
          'model', 'effort', 'thinkingVariant', 'thinkingLines',
          'reasoningText', 'thinkingDurationMs', 'timestamp', 'createdAt', 'updatedAt'
        ])
        && data.id is string && data.id == messageId && isValidId(data.id)
        && data.ownerId is string && data.ownerId == userId && isValidId(data.ownerId)
        && data.threadId is string && data.threadId == threadId && isValidId(data.threadId)
        && data.orderIndex is number && data.orderIndex >= 0 && data.orderIndex <= 10000
        && data.role is string && (data.role == 'user' || data.role == 'assistant')
        && data.content is string && data.content.size() <= 200000
        && (!data.keys().hasAny(['model']) || (data.model is string && data.model.size() <= 80))
        && (!data.keys().hasAny(['effort']) || (data.effort is string && data.effort.size() <= 40))
        && (!data.keys().hasAny(['thinkingVariant']) || (data.thinkingVariant is string && (data.thinkingVariant == 'Steps' || data.thinkingVariant == 'Reasoning' || data.thinkingVariant == 'Search' || data.thinkingVariant == 'Coding')))
        && (!data.keys().hasAny(['thinkingLines']) || (data.thinkingLines is list && data.thinkingLines.size() <= 20 && (data.thinkingLines.size() == 0 || (data.thinkingLines[0] is string && data.thinkingLines[0].size() <= 300))))
        && (!data.keys().hasAny(['reasoningText']) || (data.reasoningText is string && data.reasoningText.size() <= 150000))
        && (!data.keys().hasAny(['thinkingDurationMs']) || (data.thinkingDurationMs is number && data.thinkingDurationMs >= 0 && data.thinkingDurationMs <= 86400000))
        && data.timestamp is string && data.timestamp.size() >= 1 && data.timestamp.size() <= 32
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    match /users/{userId}/private/{docId} {
      allow get: if isValidId(userId) && isValidId(docId) && docId == 'profile' && isOwner(userId);
      allow list: if false;
      allow create: if isValidId(userId) && isValidId(docId) && docId == 'profile'
        && isOwner(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(userId) && isValidId(docId) && docId == 'profile'
        && isOwner(userId)
        && isValidUserProfile(incoming(), userId)
        && incoming().uid == existing().uid
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'email', 'updatedAt']);
      allow delete: if false;
    }

    match /users/{userId}/settings/{settingId} {
      allow get: if isValidId(userId) && isValidId(settingId) && settingId == 'preferences' && isOwner(userId);
      allow list: if false;
      allow create: if isValidId(userId) && isValidId(settingId) && settingId == 'preferences'
        && isOwner(userId)
        && isValidPreferences(incoming(), userId)
        && incoming().updatedAt == request.time;
      allow update: if isValidId(userId) && isValidId(settingId) && settingId == 'preferences'
        && isOwner(userId)
        && isValidPreferences(incoming(), userId)
        && incoming().ownerId == existing().ownerId
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly([
          'isDark', 'sendOnEnter', 'autoScroll', 'language',
          'density', 'fontScale', 'completionChime', 'spokenStatusUpdates', 'voiceAutoSubmit',
          'soundProfile', 'volume', 'betaTraces', 'betaSelectionBar',
          'betaVoiceWave', 'betaCommandSearch', 'localModelEnabled',
          'localModelReady', 'localBackend', 'updatedAt'
        ]);
      allow delete: if isValidId(userId) && isValidId(settingId) && settingId == 'preferences' && isOwner(userId);
    }

    match /users/{userId}/threads/{threadId} {
      allow get: if isValidId(userId) && isValidId(threadId) && isOwner(userId);
      allow list: if isValidId(userId) && isOwner(userId) && resource.data.ownerId == request.auth.uid;
      allow create: if isValidId(userId) && isValidId(threadId)
        && isOwner(userId)
        && isValidThread(incoming(), userId, threadId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(userId) && isValidId(threadId)
        && isOwner(userId)
        && isValidThread(incoming(), userId, threadId)
        && incoming().id == existing().id
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['title', 'updatedAtLabel', 'pinned', 'folderId', 'updatedAt']);
      allow delete: if isValidId(userId) && isValidId(threadId) && isOwner(userId);

      match /messages/{messageId} {
        allow get: if isValidId(userId) && isValidId(threadId) && isValidId(messageId)
          && isOwner(userId)
          && exists(/databases/$(database)/documents/users/$(userId)/threads/$(threadId))
          && get(/databases/$(database)/documents/users/$(userId)/threads/$(threadId)).data.ownerId == request.auth.uid;
        allow list: if isValidId(userId) && isValidId(threadId)
          && isOwner(userId)
          && resource.data.ownerId == request.auth.uid
          && resource.data.threadId == threadId;
        allow create: if isValidId(userId) && isValidId(threadId) && isValidId(messageId)
          && isOwner(userId)
          && isValidMessage(incoming(), userId, threadId, messageId)
          && incoming().createdAt == request.time
          && incoming().updatedAt == request.time
          && existsAfter(/databases/$(database)/documents/users/$(userId)/threads/$(threadId))
          && getAfter(/databases/$(database)/documents/users/$(userId)/threads/$(threadId)).data.ownerId == request.auth.uid;
        allow update: if isValidId(userId) && isValidId(threadId) && isValidId(messageId)
          && isOwner(userId)
          && isValidMessage(incoming(), userId, threadId, messageId)
          && incoming().id == existing().id
          && incoming().ownerId == existing().ownerId
          && incoming().threadId == existing().threadId
          && incoming().createdAt == existing().createdAt
          && incoming().updatedAt == request.time
          && incoming().diff(existing()).affectedKeys().hasOnly([
            'content', 'model', 'effort', 'thinkingVariant', 'thinkingLines',
            'reasoningText', 'thinkingDurationMs', 'timestamp', 'updatedAt'
          ])
          && exists(/databases/$(database)/documents/users/$(userId)/threads/$(threadId))
          && get(/databases/$(database)/documents/users/$(userId)/threads/$(threadId)).data.ownerId == request.auth.uid;
        allow delete: if isValidId(userId) && isValidId(threadId) && isValidId(messageId)
          && isOwner(userId)
          && exists(/databases/$(database)/documents/users/$(userId)/threads/$(threadId))
          && get(/databases/$(database)/documents/users/$(userId)/threads/$(threadId)).data.ownerId == request.auth.uid;
      }
    }

    match /users/{userId}/folders/{folderId} {
      allow get: if isValidId(userId) && isValidId(folderId) && isOwner(userId);
      allow list: if isValidId(userId) && isOwner(userId) && resource.data.ownerId == request.auth.uid;
      allow create: if isValidId(userId) && isValidId(folderId)
        && isOwner(userId)
        && isValidFolder(incoming(), userId, folderId)
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isValidId(userId) && isValidId(folderId)
        && isOwner(userId)
        && isValidFolder(incoming(), userId, folderId)
        && incoming().id == existing().id
        && incoming().ownerId == existing().ownerId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['name', 'updatedAt']);
      allow delete: if isValidId(userId) && isValidId(folderId) && isOwner(userId);
    }
  }
}
